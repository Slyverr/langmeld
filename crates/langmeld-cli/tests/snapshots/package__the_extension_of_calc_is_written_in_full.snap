=== src/extension.ts
// Written by `langmeld package vscode`. It starts the language server.
import * as vscode from "vscode";
import { LanguageClient } from "vscode-languageclient/node";

let client: LanguageClient | undefined;

export async function activate(context: vscode.ExtensionContext) {
  const settings = vscode.workspace.getConfiguration("calc");
  const command = settings.get<string>("server.path") || "calc";
  const server = { command, args: ["lsp"] };
  client = new LanguageClient("calc", "Calc", server, {
    documentSelector: [{ language: "calc" }],
  });
  context.subscriptions.push({ dispose: () => client?.stop() });
  await client.start();
}

export function deactivate() {
  return client?.stop();
}

=== syntaxes/calc.tmLanguage.json
{
  "name": "Calc",
  "patterns": [
    {
      "begin": "\\/\\*",
      "end": "\\*\\/",
      "name": "comment.block.calc"
    },
    {
      "match": "\\/\\/.*$",
      "name": "comment.line.calc"
    },
    {
      "begin": "\"",
      "end": "\"|$",
      "name": "string.quoted.double.calc",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.calc"
        }
      ]
    },
    {
      "match": "\\b(else|false|fn|from|if|let|return|true|use)\\b",
      "name": "keyword.control.calc"
    },
    {
      "match": "\\b(0[xX][0-9a-fA-F_]+|[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9]+)?)\\b",
      "name": "constant.numeric.calc"
    }
  ],
  "scopeName": "source.calc"
}

