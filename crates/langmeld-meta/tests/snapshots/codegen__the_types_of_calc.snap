/// One of the nodes `Expr` stands for.
#[derive(Clone, Debug, PartialEq, Eq, Hash)]
pub enum Expr {
    /// The `Literal` node.
    Literal(Literal),
    /// The `Paren` node.
    Paren(Paren),
    /// The `Var` node.
    Var(Var),
    /// The `If` node.
    If(If),
    /// The `Neg` node.
    Neg(Neg),
    /// The `Mul` node.
    Mul(Mul),
    /// The `Add` node.
    Add(Add),
    /// The `Cmp` node.
    Cmp(Cmp),
    /// The `Call` node.
    Call(Call),
}

impl ::langmeld::ast::AstNode for Expr {
    fn can_cast(kind: ::langmeld::SyntaxKind) -> bool {
        Literal::can_cast(kind)
            || Paren::can_cast(kind)
            || Var::can_cast(kind)
            || If::can_cast(kind)
            || Neg::can_cast(kind)
            || Mul::can_cast(kind)
            || Add::can_cast(kind)
            || Cmp::can_cast(kind)
            || Call::can_cast(kind)
    }

    fn cast(node: ::langmeld::SyntaxNode) -> ::core::option::Option<Self> {
        if Literal::can_cast(node.kind()) {
            return Literal::cast(node).map(Self::Literal);
        }
        if Paren::can_cast(node.kind()) {
            return Paren::cast(node).map(Self::Paren);
        }
        if Var::can_cast(node.kind()) {
            return Var::cast(node).map(Self::Var);
        }
        if If::can_cast(node.kind()) {
            return If::cast(node).map(Self::If);
        }
        if Neg::can_cast(node.kind()) {
            return Neg::cast(node).map(Self::Neg);
        }
        if Mul::can_cast(node.kind()) {
            return Mul::cast(node).map(Self::Mul);
        }
        if Add::can_cast(node.kind()) {
            return Add::cast(node).map(Self::Add);
        }
        if Cmp::can_cast(node.kind()) {
            return Cmp::cast(node).map(Self::Cmp);
        }
        if Call::can_cast(node.kind()) {
            return Call::cast(node).map(Self::Call);
        }
        ::core::option::Option::None
    }

    fn syntax(&self) -> &::langmeld::SyntaxNode {
        match self {
            Self::Literal(it) => it.syntax(),
            Self::Paren(it) => it.syntax(),
            Self::Var(it) => it.syntax(),
            Self::If(it) => it.syntax(),
            Self::Neg(it) => it.syntax(),
            Self::Mul(it) => it.syntax(),
            Self::Add(it) => it.syntax(),
            Self::Cmp(it) => it.syntax(),
            Self::Call(it) => it.syntax(),
        }
    }
}

/// One of the nodes `Item` stands for.
#[derive(Clone, Debug, PartialEq, Eq, Hash)]
pub enum Item {
    /// The `LetStmt` node.
    LetStmt(LetStmt),
    /// The `FnDecl` node.
    FnDecl(FnDecl),
    /// The `ExprStmt` node.
    ExprStmt(ExprStmt),
}

impl ::langmeld::ast::AstNode for Item {
    fn can_cast(kind: ::langmeld::SyntaxKind) -> bool {
        LetStmt::can_cast(kind) || FnDecl::can_cast(kind) || ExprStmt::can_cast(kind)
    }

    fn cast(node: ::langmeld::SyntaxNode) -> ::core::option::Option<Self> {
        if LetStmt::can_cast(node.kind()) {
            return LetStmt::cast(node).map(Self::LetStmt);
        }
        if FnDecl::can_cast(node.kind()) {
            return FnDecl::cast(node).map(Self::FnDecl);
        }
        if ExprStmt::can_cast(node.kind()) {
            return ExprStmt::cast(node).map(Self::ExprStmt);
        }
        ::core::option::Option::None
    }

    fn syntax(&self) -> &::langmeld::SyntaxNode {
        match self {
            Self::LetStmt(it) => it.syntax(),
            Self::FnDecl(it) => it.syntax(),
            Self::ExprStmt(it) => it.syntax(),
        }
    }
}

/// Handles each kind of node. No method has a default, so that code visiting trees
/// stops compiling when the grammar gains a node.
pub trait Visitor {
    /// What handling a node gives.
    type Output;

    /// Handles a `Add`.
    fn visit_add(&mut self, node: &Add) -> Self::Output;

    /// Handles a `Block`.
    fn visit_block(&mut self, node: &Block) -> Self::Output;

    /// Handles a `Call`.
    fn visit_call(&mut self, node: &Call) -> Self::Output;

    /// Handles a `Cmp`.
    fn visit_cmp(&mut self, node: &Cmp) -> Self::Output;

    /// Handles a `ExprStmt`.
    fn visit_expr_stmt(&mut self, node: &ExprStmt) -> Self::Output;

    /// Handles a `File`.
    fn visit_file(&mut self, node: &File) -> Self::Output;

    /// Handles a `FnDecl`.
    fn visit_fn_decl(&mut self, node: &FnDecl) -> Self::Output;

    /// Handles a `If`.
    fn visit_if(&mut self, node: &If) -> Self::Output;

    /// Handles a `LetStmt`.
    fn visit_let_stmt(&mut self, node: &LetStmt) -> Self::Output;

    /// Handles a `Literal`.
    fn visit_literal(&mut self, node: &Literal) -> Self::Output;

    /// Handles a `Mul`.
    fn visit_mul(&mut self, node: &Mul) -> Self::Output;

    /// Handles a `Name`.
    fn visit_name(&mut self, node: &Name) -> Self::Output;

    /// Handles a `NameRef`.
    fn visit_name_ref(&mut self, node: &NameRef) -> Self::Output;

    /// Handles a `Neg`.
    fn visit_neg(&mut self, node: &Neg) -> Self::Output;

    /// Handles a `Param`.
    fn visit_param(&mut self, node: &Param) -> Self::Output;

    /// Handles a `Paren`.
    fn visit_paren(&mut self, node: &Paren) -> Self::Output;

    /// Handles a `Var`.
    fn visit_var(&mut self, node: &Var) -> Self::Output;
}

/// Gives `node` to the method of `visitor` for its kind. Nodes of unexpected text
/// have none.
pub fn visit<V: Visitor + ?Sized>(
    visitor: &mut V,
    node: ::langmeld::SyntaxNode,
) -> ::core::option::Option<V::Output> {
    match node.kind().0 {
        42 => Add::cast(node).map(|it| visitor.visit_add(&it)),
        32 => Block::cast(node).map(|it| visitor.visit_block(&it)),
        44 => Call::cast(node).map(|it| visitor.visit_call(&it)),
        43 => Cmp::cast(node).map(|it| visitor.visit_cmp(&it)),
        33 => ExprStmt::cast(node).map(|it| visitor.visit_expr_stmt(&it)),
        28 => File::cast(node).map(|it| visitor.visit_file(&it)),
        30 => FnDecl::cast(node).map(|it| visitor.visit_fn_decl(&it)),
        39 => If::cast(node).map(|it| visitor.visit_if(&it)),
        29 => LetStmt::cast(node).map(|it| visitor.visit_let_stmt(&it)),
        36 => Literal::cast(node).map(|it| visitor.visit_literal(&it)),
        41 => Mul::cast(node).map(|it| visitor.visit_mul(&it)),
        34 => Name::cast(node).map(|it| visitor.visit_name(&it)),
        35 => NameRef::cast(node).map(|it| visitor.visit_name_ref(&it)),
        40 => Neg::cast(node).map(|it| visitor.visit_neg(&it)),
        31 => Param::cast(node).map(|it| visitor.visit_param(&it)),
        37 => Paren::cast(node).map(|it| visitor.visit_paren(&it)),
        38 => Var::cast(node).map(|it| visitor.visit_var(&it)),
        _ => ::core::option::Option::None,
    }
}

/// The language, as the build script compiled it.
pub fn source() -> ::langmeld::Source {
    ::langmeld::Source::embedded(include_bytes!(concat!(env!("OUT_DIR"), "/language.bin")))
}

/// The language and what it tells editors, read once.
pub fn loaded() -> &'static ::langmeld::Loaded {
    static LOADED: ::std::sync::OnceLock<::langmeld::Loaded> = ::std::sync::OnceLock::new();
    LOADED.get_or_init(|| {
        ::langmeld::load_language(source()).expect("the build script compiled it with this version")
    })
}

/// The language, read once.
pub fn language() -> &'static ::langmeld::Language {
    &loaded().language
}
