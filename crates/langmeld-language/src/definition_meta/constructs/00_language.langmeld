constructs {
construct language {
  syntax {
    root: "language {name} {"
    constructs: "constructs {"
    expressions: "expressions {"
    types: "types {"
  }
  fields {
    name: identifier optional
  }
  block: [language_version, language_root, schema_version_decl, source_extension_decl, import_decl, lexical_decl, category_decl, behavior_decl, rule_decl, construct, enum_decl, record_type, properties_bundle, expression_decl]
}

construct language_version {
  syntax {
    default: "version: {value}"
  }
  fields {
    value: string required
  }
}

construct language_root {
  syntax {
    default: "root: {value}"
  }
  fields {
    value: identifier required
  }
}

construct schema_version_decl {
  syntax {
    default: "schema_version: {value}"
  }
  fields {
    value: number required
  }
}

construct source_extension_decl {
  syntax {
    default: "source_extension: {value}"
  }
  fields {
    value: string required
  }
}

construct import_decl {
  syntax {
    default: "import: {path}"
  }
  fields {
    path: string required
  }
}

construct lexical_decl {
  syntax { root: "lexical {" }
  block: [line_comment_decl, block_comment_decl]
}

construct line_comment_decl {
  syntax { default: "line_comment: {marker}" }
  fields { marker: string required }
}

construct block_comment_decl {
  syntax { default: "block_comment: {open} {close}" }
  fields {
    open: string required
    close: string required
  }
}

construct category_decl {
  syntax {
    root: "category {id} {"
  }
  fields {
    id: identifier required
  }
  block: []
}

construct behavior_decl {
  syntax {
    default: "behavior {id}: {stage}"
  }
  fields {
    id: identifier required
    stage: identifier required
  }
}

construct rule_decl {
  syntax {
    simple: "rule {id}: {pattern}"
    parameterized: "rule {id}\\(({parameters}[,])*\\): {pattern}"
  }
  fields {
    id: identifier required
    parameters: list<identifier> optional
    pattern: string required
  }
}
}
