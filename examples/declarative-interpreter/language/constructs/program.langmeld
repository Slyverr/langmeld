constructs {
  construct program {
    syntax {
      default: "program {"
    }
    block: [statement]
  }

  construct set {
    implements: statement
    syntax {
      default: "set {name} to {value}"
    }
    fields {
      name: identifier required
      value: number required
    }
    symbol {
      kind: variable
      name: name
    }
  }

  construct add {
    implements: statement
    syntax {
      default: "add {left} and {right} as {name}"
    }
    fields {
      left: ref<variable> required
      right: ref<variable> required
      name: identifier required
    }
    symbol {
      kind: variable
      name: name
    }
  }

  construct print {
    implements: statement
    syntax {
      default: "print {target}"
    }
    fields {
      target: ref<variable> required
    }
  }
}
