construct "function" {
    syntax "signature" {
        literal "fn";
        identifier "name";
        literal "(";
        optional "parameters" {
            identifier "first_parameter";
            literal ":";
            identifier "first_parameter_type";
            zero_or_more "additional_parameters" {
                literal ",";
                identifier "parameter";
                literal ":";
                identifier "parameter_type";
            }
        }
        literal ")";
        literal "->";
        identifier "return_type";
    }

    block "{" "}" {
        allow_category "statement";
    }

    implements "declaration";
}

construct "invoke" {
    syntax "keyword_call" {
        literal "invoke";
        expression "call" until ";";
    }

    syntax "call_statement" {
        literal "call";
        expression "call" until ";";
    }

    implements "statement";
}
