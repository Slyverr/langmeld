language "WidgetScript" {
    import "constructs/statements.langmeld";
    root "program";
    lexical {
        line_comment "//";
        block_comment "/*" "*/";
    }
    construct "program" {
        syntax {
            literal "program";
        }
        block "{" "}" {
            allow_category "statement";
        }
    }
}
