import "values.langmeld";

construct "draw" {
    syntax {
        literal "draw";
        choice "shape" {
            value "circle";
            value "square";
        }
        literal ";";
    }
    implements "statement";
}

construct "compute" {
    syntax {
        literal "compute";
        expression "value" until ";";
    }
    implements "statement";
}
