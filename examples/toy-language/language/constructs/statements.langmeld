import "values.langmeld";
construct "draw" {
    completion "keyword";
    syntax {
        literal "draw";
        choice "shape" {
            value "circle";
            value "square";
        }
        optional {
            literal "labeled";
            string "label";
        }
        literal ";";
    }
    implements "statement";
}
construct "compute" {
    completion "keyword";
    syntax {
        literal "compute";
        expression "value" until ";";
    }
    implements "statement";
}
construct "emit" {
    completion "keyword";
    syntax {
        literal "emit";
        one_or_more {
            string "message";
            optional {
                literal ",";
            }
        }
        literal ";";
    }
    implements "statement";
}
