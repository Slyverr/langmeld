import "values.langmeld";
construct "draw" {
    completion "keyword";
    syntax {
        literal "draw";
        choice "shape" {
            value "circle";
            value "square";
        }
        literal ";";
    }
    implements "statement";
}
construct "compute" {
    completion "keyword";
    syntax {
        literal "compute";
        expression "value" until ";";
    }
    implements "statement";
}
