# Words and symbols of the .langmeld format.
"langmeld 1"
"language"
"extensions"
"comments"
"terminators"
"continue_inside"
"tokens"
"skip"
"preset"
"interpolate"
"keywords"
"contextual"
"rule"
"expr"
"atom"
"prefix"
"infix"
"postfix"
"prec"
"left"
"right"
"none"
"extern token"
"extern rule"
"first"
"bind"
"scope"
"defines"
"refers"
"imports"
"includes members of"
"editor"
"symbol"
"fold"
"highlight"
"import"
"sep("
"sep_strict("
"terminated("
"try ("
"recover"
"->"
"\x22"
"//"
"/"
"{"
"}"
