langmeld 1

language Json {
    extensions "json"
}

tokens {
    skip space = /[ \t\r\n]+/
    string     = preset string(double)
    number     = /-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?/
    word       = preset ident(ascii)     // so that `true`, `false` and `null` are words
}

rule File    = value:Value
rule Value   = Object | Array | Literal
rule Object  = "{" members:sep_strict(Member, ",") "}"
rule Member  = key:string ":" value:Value
rule Array   = "[" items:sep_strict(Value, ",") "]"
rule Literal = string | number | "true" | "false" | "null"
